# Copy this file to .streamlit/secrets.toml (on your computer) and paste the same
# text into Streamlit Cloud -> your app -> Settings -> Secrets.
# NEVER upload secrets.toml to GitHub (.gitignore already blocks it).

[app]
backend = "drive"              # "drive" = Google Drive, "local" = folder on this computer (testing)
root_folder = "Homework Tracker"
timezone = "Asia/Colombo"
deadline = "18:15"             # daily upload deadline, 24-hour clock
son_name = "Son"               # shown on the sign-in screen, e.g. his first name
parent_name = "Dad"

[subjects]                     # subject = number of days per week
Maths = 2
Science = 2
Geography = 2

[auth]
son_password = "choose-a-password-for-your-son"
parent_password = "choose-a-DIFFERENT-password-for-you"

[google]                       # printed for you by tools/get_refresh_token.py
client_id = "532322554017-vtmd1s7kskpfiek73m5cu02o6mrph41b.apps.googleusercontent.com"
client_secret = "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"
refresh_token = "1//0g6oisV_SknXzCgYIARAAGBASNwF-L9Irijm5zf_nYtRvpVoopbuJtwgU3bF3AF55Ool4XSkt52RdL4MAoqeFXiR6FiGvHvWbzJs"
